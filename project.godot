; Engine configuration file.
config_version=5

[application]

config/name="AB206 REALSIM"
config/description="Bell 206B-3 helicopter flight simulator - milestone 2.5 (training)"
config/version="0.2.13-M2.13"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
run/max_fps=60
boot_splash/bg_color=Color(0.08, 0.09, 0.1, 1)

[audio]

general/text_to_speech=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=6

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
scaling_3d/mode=0
scaling_3d/scale=0.67
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.55, 0.68, 0.82, 1)
